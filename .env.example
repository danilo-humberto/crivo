# Configure only after choosing and authorizing an isolated development database.
DATABASE_URL=
VAULT_DB_ENV=development
VAULT_EXPECTED_DATABASE=
VAULT_EXPECTED_ROLE=
# Set to yes only for an explicitly approved import; preview needs none of these.
VAULT_IMPORT_APPROVED=no
# Managed mode is the default. local is an explicit legacy browser-only mode.
VAULT_MODE=managed
APP_ORIGIN=http://localhost:4173
NEON_AUTH_BASE_URL=
# At least 32 random characters, provided through a secure mechanism.
NEON_AUTH_COOKIE_SECRET=
VAULT_BOOTSTRAP_APPROVED=no
VAULT_INTEGRATION_APPROVED=no

# URL HTTPS da foto: marcador obrigatório, sem cópia local da imagem.
EMPLOYEE_PHOTO_BASE_URL=https://intranet-cifra.netlify.app/funcionarios/{cpf}.jpeg
