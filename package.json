{
  "name": "vault-ti",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node server/build.cjs",
    "prestart": "npm run build",
    "start": "node server/start-local.cjs",
    "test": "node --test tests/*.test.cjs",
    "import:preview": "node server/import-cli.cjs",
    "test:integration": "node --test tests/integration/*.test.cjs",
    "build:worker": "npm run build && node server/build-worker.cjs",
    "test:worker": "npm run build:worker && node --test tests/workers/*.test.cjs",
    "check:worker": "npm run build:worker && wrangler deploy --dry-run --config workers/wrangler.jsonc --outdir dist/worker-bundle"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.159.0"
  }
}
